{
  "name": "@orion/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare-assets": "node scripts/copy-pdf-worker.mjs && node scripts/copy-modern-xlsx-wasm.mjs",
    "dev": "node scripts/copy-pdf-worker.mjs && node scripts/copy-modern-xlsx-wasm.mjs && next dev --port 3010",
    "build": "node scripts/copy-pdf-worker.mjs && node scripts/copy-modern-xlsx-wasm.mjs && next build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:desktop": "node scripts/copy-pdf-worker.mjs && node scripts/copy-modern-xlsx-wasm.mjs && cross-env DESKTOP_EXPORT=1 next build",
    "start": "next start --port 3010"
  },
  "dependencies": {
    "@orion/core": "workspace:*",
    "@orion/core-react": "workspace:*",
    "@orion/shared-types": "workspace:*",
    "@orion/ui": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.2.1",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "dockview": "^4.7.0",
    "dockview-react": "^4.7.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.11.9",
    "hyperformula": "^3.4.0",
    "lightweight-charts": "5.2.1",
    "lucide-react": "^0.446.0",
    "mammoth": "^1.8.0",
    "modern-xlsx": "^1.2.1",
    "next": "^14.2.15",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "jszip": "^3.10.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
