DATABASE_URL="postgresql://orion:orion_local_dev@127.0.0.1:5433/orion"
# What the running API actually connects as day-to-day: NOSUPERUSER,
# NOBYPASSRLS, so FORCE ROW LEVEL SECURITY genuinely applies to it, unlike
# the superuser role above (kept only for Prisma migrations). See
# infra/postgres/init/01-app-roles.sql.
APP_DATABASE_URL="postgresql://orion_app:replace-with-orion_app-password@127.0.0.1:5433/orion"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30
PORT=4000
WEB_ORIGIN="http://localhost:3010"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
