DATABASE_URL="postgresql://orion:orion_local_dev@127.0.0.1:5433/orion"
# What the running API actually connects as day-to-day: NOSUPERUSER,
# NOBYPASSRLS, so FORCE ROW LEVEL SECURITY genuinely applies to it, unlike
# the superuser role above (kept only for Prisma migrations). See
# infra/postgres/init/01-app-roles.sql.
APP_DATABASE_URL="postgresql://orion_app:replace-with-orion_app-password@127.0.0.1:5433/orion"
# --- Режим (S05) ---------------------------------------------------------------
# "local" (по умолчанию) — один человек, один процесс, слушает только
# loopback (127.0.0.1), если HOST не задан явно; выдаёт directory локальных
# аккаунтов ("account picker") и разрешает PIN-разблокировку.
# "server" — многопользовательский узел на реальной сети: directory/PIN
# отключены, регистрация требует полноценный пароль, а JWT_SECRET
# ОБЯЗАТЕЛЕН — без него процесс не запустится (небезопасный dev-фолбэк не
# должен попадать в серверный путь). См. docs/DEPLOYMENT_READINESS.md.
ORION_MODE=local
# Явный адрес прослушивания. Если не задан — 127.0.0.1 в local-режиме,
# 0.0.0.0 в server-режиме.
HOST=
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_TTL_DAYS=30
PORT=4000
WEB_ORIGIN="http://localhost:3010"
# Only when API is behind a known reverse proxy: comma-separated proxy IPs/CIDRs.
# Never put client networks here. Proxy must overwrite incoming X-Forwarded-For
# and API must not be directly reachable by clients from a trusted proxy address.
# With this unset, X-Forwarded-For is ignored.
# Example for a same-host proxy: 127.0.0.1/8,::1/128
ORION_TRUSTED_PROXIES=
# Several browser origins may be supplied as a comma-separated WEB_ORIGINS.
# Tauri origins http://tauri.localhost and tauri://localhost are always allowed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Разрешить loopback/private-адреса для исходящих календарей и WebDAV-удалёнки
# (self-hosted Nextcloud/Radicale на той же локальной сети и т.п.). По
# умолчанию такие адреса отклоняются как SSRF-риск (S05).
ALLOW_PRIVATE_CALENDAR_URLS=false

# --- Документы (v0.12) --------------------------------------------------------
# Where uploaded files live. "local" mirrors the folder tree as a real
# directory under STORAGE_DIR (browsable in Explorer); "webdav" does the same
# on a WebDAV share. An unknown value makes the API fail at boot on purpose.
STORAGE_DRIVER=local
STORAGE_DIR=./.data/documents
# Largest single uploaded file, megabytes.
MAX_UPLOAD_MB=50
# Only used when STORAGE_DRIVER=webdav.
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# --- Синхронизация / бэкап в облако (WebDAV) ---------------------------------
# Полный разбор и архитектура — docs/SYNC.md. Ключ, которым модуль шифрует
# пароль удалёнки перед записью в БД (sync_remotes.passwordEnc) и тело
# снапшота бэкапа. 32 байта в base64. Без него модуль откажется сохранять
# удалёнку (а не запишет пароль открытым текстом).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SYNC_SECRET=
