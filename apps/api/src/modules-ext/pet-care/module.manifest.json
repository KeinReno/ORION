{
  "id": "pet-care",
  "version": "1.0.0",
  "catalog": {
    "kind": "additional",
    "required": false,
    "label": "Питомцы",
    "summary": "Карточки питомцев, журнал ухода и дневник самочувствия: симптомы по дням, события, статистика, отчёт для ветеринара.",
    "owns": "Питомцы пространства (профиль, порода, контакт клиники), записи ухода, дневник самочувствия по дням и события питомца.",
    "livesWithout": "Полностью самостоятелен: не требует и не использует другие предметные модули.",
    "provides": [
      "Панель «Питомцы»",
      "Журнал ухода по каждому питомцу",
      "Дневник самочувствия с календарём, статистикой и отчётом для ветеринара",
      "Импорт резервной копии MurHP"
    ],
    "optionalDependencies": [],
    "disableBehavior": "Панель и API скрываются. Питомцы, записи ухода, дневник и события сохраняются и вернутся при включении.",
    "panelId": "pet-care",
    "defaultEnabled": true
  },
  "permissions": {
    "primaryResource": "pet"
  },
  "api": {
    "module": {
      "file": "pet-care.module",
      "export": "PetCareModule"
    },
    "probePath": "/pet-care/pets"
  },
  "web": {
    "panel": {
      "id": "pet-care",
      "label": "Питомцы",
      "icon": "PawPrint",
      "group": "Семья и дом",
      "file": "PetCarePanel",
      "export": "PetCarePanel"
    }
  },
  "prisma": {
    "fragment": "prisma/models.prisma",
    "workspaceBackRelations": [
      "petCarePets    PetCarePet[]",
      "petCareEntries PetCareEntry[]",
      "petCareDays    PetCareDay[]",
      "petCareEvents  PetCareEvent[]"
    ],
    "migrations": [
      {
        "name": "20261018120000_pet_care",
        "file": "prisma/migration.sql",
        "rls": "workspace-member"
      },
      {
        "name": "20261019150000_pet_care_wellbeing",
        "file": "prisma/migration-wellbeing.sql",
        "rls": "workspace-member"
      }
    ]
  },
  "data": {
    "models": [
      {
        "model": "PetCarePet",
        "delegate": "petCarePet",
        "snapshotKey": "petCarePets",
        "snapshotPolicy": "included",
        "reason": "Питомцы — пользовательский контент модуля; вставляются раньше записей ухода, которые на них ссылаются.",
        "sync": {
          "syncClass": "lww-fields",
          "stage": "later",
          "note": "Поля питомца — LWW по полю; офлайн-запись не включена."
        }
      },
      {
        "model": "PetCareEntry",
        "delegate": "petCareEntry",
        "snapshotKey": "petCareEntries",
        "snapshotPolicy": "included",
        "reason": "Журнал ухода — пользовательский контент; после питомцев (petId).",
        "sync": {
          "syncClass": "append-only",
          "stage": "later",
          "note": "Запись ухода — факт: добавляется, не правится; дубли гасит естественный ключ клиента."
        }
      },
      {
        "model": "PetCareDay",
        "delegate": "petCareDay",
        "snapshotKey": "petCareDays",
        "snapshotPolicy": "included",
        "reason": "Дневник самочувствия — пользовательский контент; после питомцев (petId). День один на (питомец, дата).",
        "sync": {
          "syncClass": "lww-fields",
          "stage": "later",
          "note": "Запись дня заменяется целиком (PUT по (petId, day)); офлайн-запись не включена."
        }
      },
      {
        "model": "PetCareEvent",
        "delegate": "petCareEvent",
        "snapshotKey": "petCareEvents",
        "snapshotPolicy": "included",
        "reason": "События питомца — пользовательский контент; после питомцев (petId).",
        "sync": {
          "syncClass": "append-only",
          "stage": "later",
          "note": "Событие — факт: добавляется и удаляется, не правится."
        }
      }
    ]
  },
  "agent": {
    "controller": {
      "file": "pet-care.agent.controller",
      "export": "PetCareAgentController"
    },
    "tools": [
      {
        "name": "orion_pet_care_list_pets",
        "op": "read",
        "description": "Список питомцев пространства (id, имя, вид, день рождения, заметки). id нужен для orion_pet_care_add_entry.",
        "http": {
          "method": "GET",
          "path": "/ai/v1/pet-care/pets"
        },
        "input": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "orion_pet_care_add_entry",
        "op": "create",
        "description": "Записать в журнал ухода факт: кормление, ветеринар, лекарство или прогулка. Это факт, а не напоминание.",
        "http": {
          "method": "POST",
          "path": "/ai/v1/pet-care/pets/{petId}/entries"
        },
        "input": {
          "type": "object",
          "properties": {
            "petId": {
              "type": "string",
              "description": "id питомца из orion_pet_care_list_pets"
            },
            "kind": {
              "type": "string",
              "enum": [
                "feeding",
                "vet",
                "medication",
                "walk"
              ],
              "description": "feeding — кормление, vet — ветеринар, medication — лекарство, walk — прогулка"
            },
            "occurredAt": {
              "type": "string",
              "description": "Когда было (ISO-дата со временем); без значения — сейчас"
            },
            "note": {
              "type": "string",
              "description": "Комментарий (до 2000 символов)"
            }
          },
          "required": [
            "petId",
            "kind"
          ],
          "additionalProperties": false
        },
        "example": {
          "petId": "<id питомца>",
          "kind": "feeding",
          "note": "Сухой корм, 60 г"
        }
      },
      {
        "name": "orion_pet_care_diary",
        "op": "read",
        "description": "Дневник самочувствия питомца за период (по умолчанию 30 дней): состояние дня, аппетит, активность, стул, вода, рвота, вес, температура, лекарства, симптомы, заметка — и тревожные сигналы по этим отметкам (не диагноз).",
        "http": {
          "method": "GET",
          "path": "/ai/v1/pet-care/pets/{petId}/days"
        },
        "input": {
          "type": "object",
          "properties": {
            "petId": {
              "type": "string",
              "description": "id питомца из orion_pet_care_list_pets"
            },
            "from": {
              "type": "string",
              "description": "С дня YYYY-MM-DD"
            },
            "to": {
              "type": "string",
              "description": "По день YYYY-MM-DD"
            },
            "today": {
              "type": "string",
              "description": "Сегодня по времени пользователя, YYYY-MM-DD"
            }
          },
          "required": [
            "petId"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "orion_pet_care_record_day",
        "op": "create",
        "description": "Отметить самочувствие питомца за день: переданные поля дописываются к уже записанному за этот день (симптом с тем же id заменяется). appetite: normal|reduced|picky|refused; activity: normal|low|very_low|restless; stool: none|normal|soft|liquid|constipation|blood|mucus; water: normal|reduced|none; symptoms: [{id, severity: mild|moderate|severe|critical, count, time: morning|day|evening|night, note}] — id из каталога (vomiting, diarrhea, lethargy, no_appetite…).",
        "http": {
          "method": "POST",
          "path": "/ai/v1/pet-care/pets/{petId}/days/{day}"
        },
        "input": {
          "type": "object",
          "properties": {
            "petId": {
              "type": "string",
              "description": "id питомца"
            },
            "day": {
              "type": "string",
              "description": "День YYYY-MM-DD"
            },
            "appetite": {
              "type": "string",
              "description": "Аппетит"
            },
            "activity": {
              "type": "string",
              "description": "Активность"
            },
            "stool": {
              "type": "string",
              "description": "Стул"
            },
            "water": {
              "type": "string",
              "description": "Вода"
            },
            "vomitingCount": {
              "type": "integer",
              "description": "Сколько раз рвало"
            },
            "weightKg": {
              "type": "number",
              "description": "Вес, кг"
            },
            "temperature": {
              "type": "number",
              "description": "Температура, °C"
            },
            "meds": {
              "type": "string",
              "description": "Лекарства и процедуры — как записал хозяин"
            },
            "note": {
              "type": "string",
              "description": "Заметка (дописывается)"
            },
            "symptoms": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Симптомы"
            }
          },
          "required": [
            "petId",
            "day"
          ],
          "additionalProperties": false
        },
        "example": {
          "petId": "<id питомца>",
          "day": "2026-10-20",
          "vomitingCount": 2,
          "appetite": "reduced"
        }
      },
      {
        "name": "orion_pet_care_add_event",
        "op": "create",
        "description": "Записать событие, которое может объяснять самочувствие: смена корма, новый продукт, лекарство, прививка, обработка от паразитов, визит к ветеринару, стресс, заметка.",
        "http": {
          "method": "POST",
          "path": "/ai/v1/pet-care/pets/{petId}/events"
        },
        "input": {
          "type": "object",
          "properties": {
            "petId": {
              "type": "string",
              "description": "id питомца"
            },
            "day": {
              "type": "string",
              "description": "День YYYY-MM-DD"
            },
            "type": {
              "type": "string",
              "enum": [
                "food_change",
                "new_food",
                "medication",
                "vaccination",
                "antiparasitic",
                "vet_visit",
                "stress",
                "note"
              ],
              "description": "Вид события"
            },
            "title": {
              "type": "string",
              "description": "Кратко"
            },
            "note": {
              "type": "string",
              "description": "Подробности"
            }
          },
          "required": [
            "petId",
            "day"
          ],
          "additionalProperties": false
        }
      }
    ]
  }
}
