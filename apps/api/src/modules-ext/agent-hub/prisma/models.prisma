/// A durable execution attempt, distinct from the existing Task and AgentJob records.
/// `parentExecutionId` deliberately has no FK: a snapshot restore inserts rows in
/// registry order and a self-reference would make the order significant.
model AgentHubExecution {
  id            String   @id @default(uuid())
  workspaceId   String
  targetKind    String
  targetId      String
  status        String   @default("queued")
  revision      Int      @default(0)
  attempt       Int      @default(0)
  workerId      String?
  runtimeId     String?
  leaseUntil    DateTime?
  checkpointRef String?
  evidenceRefs  Json     @default("[]")
  verifiedBy    String?
  blockedReason String?
  /// Delegation tree: branch parent, depth below the root and the profile the branch was handed to.
  parentExecutionId    String?
  delegationDepth      Int      @default(0)
  delegatedToProfileId String?
  /// Profiles that already took part in this branch (oldest first); the cycle guard.
  delegationChain      Json     @default("[]")
  /// Structured order payload: task, project, material link ids, permission constraints.
  delegationPayload    Json     @default("{}")
  /// Pending human approval: action, reason, requestedAt, requestedBy.
  approval             Json?
  /// Short summary handed to the parent branch on a terminal transition.
  resultSummary        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    AgentHubEvent[]
  steps     AgentHubTraceStep[]

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, targetKind, targetId])
  @@index([workspaceId, status])
  @@index([parentExecutionId])
  @@map("agent_hub_executions")
}

/// Append-only execution log; unique (executionId, revision) guards duplicate commits.
model AgentHubEvent {
  id          String   @id @default(uuid())
  workspaceId String
  executionId String
  revision    Int
  action      String
  actorId     String
  data        Json     @default("{}")
  at          DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  execution AgentHubExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, revision])
  @@index([workspaceId, executionId])
  @@map("agent_hub_events")
}

/// An agent-reported local observer session. TTL = recently authenticated, not proof of running AI.
model AgentHubRuntimeSession {
  id              String   @id
  workspaceId     String
  tokenId         String
  kind            String   @default("habitat_observer")
  status          String   @default("active")
  revision        Int      @default(0)
  capabilities    Json     @default("{}")
  startedAt       DateTime @default(now())
  lastHeartbeatAt DateTime @default(now())
  expiresAt       DateTime
  closedAt        DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
  @@index([workspaceId, tokenId])
  @@map("agent_hub_runtime_sessions")
}

/// Stable logical agent identity. Credentials and runtime sessions are separate, replaceable records.
model AgentHubAgentProfile {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credentials AgentHubAgentCredential[]
  assignments AgentHubTaskAssignment[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@index([workspaceId, name])
  @@map("agent_hub_agent_profiles")
}

/// Explicit binding of an AI Bridge credential to a stable profile. Excluded from snapshots.
model AgentHubAgentCredential {
  id          String   @id @default(uuid())
  workspaceId String
  profileId   String
  tokenId     String   @unique
  createdById String
  createdAt   DateTime @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   AgentHubAgentProfile @relation(fields: [workspaceId, profileId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, profileId])
  @@map("agent_hub_agent_credentials")
}

/// Current task executor. One profile per task; this does not create an execution or dispatch work.
model AgentHubTaskAssignment {
  id          String   @id @default(uuid())
  workspaceId String
  taskId      String
  profileId   String
  assignedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   AgentHubAgentProfile @relation(fields: [workspaceId, profileId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, taskId])
  @@index([workspaceId, profileId])
  @@map("agent_hub_task_assignments")
}

/// One reported or derived step of a real execution. Reasoning is never stored here.
model AgentHubTraceStep {
  id           String   @id @default(uuid())
  workspaceId  String
  executionId  String
  /// Logical step id, unique inside one execution; parents refer to it, not to a row id.
  stepId       String
  parentStepId String?
  /// tool_call | tool_result | delegation | approval_wait | note | error
  type         String
  name         String?
  /// Stable agent profile when the reporting credential is bound to one.
  agentId      String?
  actorId      String
  payload      Json     @default("{}")
  durationMs   Int?
  error        String?
  attempt      Int      @default(0)
  at           DateTime @default(now())

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  execution AgentHubExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, stepId])
  @@index([workspaceId, executionId, at])
  @@index([workspaceId, agentId])
  @@map("agent_hub_trace_steps")
}

/// Versioned agent memory. Exactly one `valid` row per (scope, scopeId, key) — enforced
/// by a partial unique index — while superseded rows keep the revision history.
model AgentMemoryRecord {
  id                String   @id @default(uuid())
  workspaceId       String
  /// user | project | agent | global
  scope             String
  /// userId / projectId / profileId; null for global.
  scopeId           String?
  key               String
  value             Json
  /// agent | user | system
  source            String
  /// Profile that wrote it; null when a human wrote the record.
  agentId           String?
  userId            String?
  provenanceEventId String?
  /// valid | superseded | outdated
  validity          String   @default("valid")
  /// No FK on purpose: snapshot restore must not depend on self-reference order.
  supersededById    String?
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope, scopeId, key])
  @@index([workspaceId, key])
  @@index([workspaceId, validity])
  @@map("agent_memory_records")
}

/// Owner-controlled delegation policy; one row per workspace, created on first write.
/// `approvals` — кто обязан ждать человеческого подтверждения (миграция
/// 20261117013000_agent_hub_approval_policy; дефолт non_admin сохраняет поведение).
model AgentHubPolicy {
  id                 String   @id @default(uuid())
  workspaceId        String   @unique
  maxDelegationDepth Int      @default(3)
  approvals          String   @default("non_admin")
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("agent_hub_policies")
}
