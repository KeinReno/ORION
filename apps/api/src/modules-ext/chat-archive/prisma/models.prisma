model ChatArchiveConversation {
  id           String    @id @default(uuid())
  workspaceId  String
  /// Владелец: архив личный, другие участники пространства его не видят (RLS).
  userId       String
  /// claude-code | codex — откуда транскрипт.
  source       String
  /// id сессии в источнике: повторный импорт дописывает к тому же разговору.
  externalId   String
  title        String
  /// Откуда заголовок: fallback (первая реплика) < auto (придумал источник) < custom (задан в источнике) < manual (в ORION).
  titleSource  String    @default("fallback")
  projectPath  String?
  startedAt    DateTime?
  lastAt       DateTime?
  lineCount    Int       @default(0)
  messageCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lines     ChatArchiveLine[]

  @@unique([workspaceId, userId, source, externalId], map: "chat_archive_conversations_session_key")
  @@index([workspaceId, userId, lastAt])
  @@map("chat_archive_conversations")
}

model ChatArchiveLine {
  id             String    @id @default(uuid())
  workspaceId    String
  userId         String
  conversationId String
  /// Номер строки исходного файла (с 0): оригинал = строки по seq через "\n".
  seq            Int
  role           String
  kind           String
  /// Извлечённый читаемый текст (для просмотра и поиска; длинное обрезано — целиком в raw).
  text           String    @default("")
  /// Строка исходного файла без изменений.
  raw            String
  /// sha256(raw): сверка перекрытия при повторном импорте без чтения больших строк.
  sha            String
  at             DateTime?

  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation ChatArchiveConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@index([workspaceId])
  @@map("chat_archive_lines")
}

/// ORION-16 — opt-in тумблер автосбора по источнику, выключен по умолчанию. Личный, как сам архив.
model ChatArchiveAutoSource {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  /// claude-code | codex — см. CHAT_ARCHIVE_SOURCES.
  source      String
  enabled     Boolean   @default(true)
  /// Последний успешный проход сканера для этого источника — отсекает уже просмотренные файлы по mtime.
  lastScanAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, source], map: "chat_archive_auto_sources_key")
  @@index([workspaceId])
  @@map("chat_archive_auto_sources")
}
