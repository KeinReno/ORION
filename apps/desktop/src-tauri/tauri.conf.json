{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORION",
  "version": "0.1.40",
  "identifier": "com.orion.desktop",
  "build": {
    "frontendDist": "../../web/.next-desktop",
    "devUrl": "http://localhost:3010"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ORION",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' blob: http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src http: https:; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["orion"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "resources/": "" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
