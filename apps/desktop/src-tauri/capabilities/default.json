{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for trusted ORION UI webviews, including detached panels and workspaces",
  "webviews": ["main", "panel-*", "workspace-*"],
  "permissions": [
    "core:default",
    "notification:default",
    "deep-link:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-create"
  ]
}
