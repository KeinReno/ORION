{
  "name": "orion",
  "private": true,
  "version": "0.1.0",
  "description": "ORION core — modular monolith backend + shared React frontend core",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev:api": "corepack pnpm --filter @orion/api dev",
    "dev:web": "corepack pnpm --filter @orion/web dev",
    "dev:desktop": "corepack pnpm --filter @orion/desktop tauri dev",
    "dev:app": "node scripts/launch-desktop.mjs",
    "dev:rust": "node scripts/orion-rust-dev.mjs up",
    "build": "corepack pnpm -r build",
    "build:desktop-export": "corepack pnpm --filter @orion/web build:desktop",
    "build:desktop-installer": "node scripts/build-desktop-installer.mjs",
    "build:desktop-stage": "node scripts/build-desktop-installer.mjs --stage-only",
    "build:desktop-payload": "node scripts/build-runtime-payload.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "corepack pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/e2e-local.mjs",
    "ops:restore-rehearsal": "node scripts/restore-rehearsal.mjs",
    "architecture-check": "node scripts/architecture-check.mjs",
    "module-docs": "node scripts/module-docs.mjs",
    "module-docs:check": "node scripts/module-docs.mjs --check",
    "module-registry": "node scripts/module-registry.mjs",
    "platform-map": "node scripts/platform-map.mjs",
    "platform-map:check": "node scripts/platform-map.mjs --check",
    "create:module": "node scripts/create-module.mjs",
    "orion-ext": "node scripts/orion-ext.mjs",
    "plugin-contract-check": "vitest run apps/web/lib/extensions/registry.test.ts",
    "quality": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm test && corepack pnpm build",
    "db:up": "node scripts/postgres.mjs up",
    "db:down": "node scripts/postgres.mjs down",
    "db:status": "node scripts/postgres.mjs status",
    "db:up:docker": "docker compose -f infra/postgres/docker-compose.yml up -d",
    "db:down:docker": "docker compose -f infra/postgres/docker-compose.yml down",
    "db:migrate": "corepack pnpm --filter @orion/api prisma:migrate:dev",
    "db:generate": "corepack pnpm --filter @orion/api prisma:generate",
    "db:seed-dev": "node scripts/seed-dev-user.mjs",
    "demo:seed": "node scripts/seed-demo-workspace.mjs",
    "demo:pack": "node scripts/pack-demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "1.64.0",
    "embedded-postgres": "16.14.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "jsdom": "^30.1.1",
    "jszip": "3.10.1",
    "pg": "^8.23.0",
    "typescript-eslint": "^8.11.0",
    "vitest": "^5.0.0"
  }
}
