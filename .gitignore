apps/web/public/modern-xlsx.wasm

# Local document/blob store (STORAGE_DRIVER=local); never upload dev workspaces.
apps/api/.data/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
/.ignore

# Compass engine: runtime data and caches.
apps/compass-engine/**/__pycache__/

# Playwright (e2e/)
test-results/
playwright-report/

# Root .data/: local runtime leftovers (e.g. a portable node), never source.
/.data/
