name: Экраны запуска

children:
  - id: note.loading
    type: text
    position: [ 80, 92 ]
    size: [ hug, hug ]
    fontSize: 36
    fontWeight: 600
    color: "#000000"
    content: Загрузка

  - id: note.premiere
    type: text
    position: [ 1480, 92 ]
    size: [ hug, hug ]
    fontSize: 36
    fontWeight: 600
    color: "#000000"
    content: Первый запуск

  - id: note.error
    type: text
    position: [ 80, 1052 ]
    size: [ hug, hug ]
    fontSize: 36
    fontWeight: 600
    color: "#000000"
    content: Ошибка

  - id: note.minimal
    type: text
    position: [ 1480, 1052 ]
    size: [ hug, hug ]
    fontSize: 36
    fontWeight: 600
    color: "#000000"
    content: Минимальный

  # ---------------------------------------------------------- 1. Загрузка
  - id: screen.loading
    type: frame
    position: [ 80, 160 ]
    size: [ 1280, 800 ]
    fill: $color.canvas
    layout: { type: free, overflow: hidden }
    children:
      - id: ld.glow
        type: ellipse
        position: [ 390, 8 ]
        size: [ 500, 500 ]
        fill:
          type: radialGradient
          stops:
            - [ 0, "#C9A86A33" ]
            - [ 1, "#C9A86A00" ]
      - id: ld.orbit.a
        type: ellipse
        position: [ 290, -92 ]
        size: [ 700, 700 ]
        stroke: { color: "#C9A86A1F", width: 1 }
      - id: ld.orbit.b
        type: ellipse
        position: [ 150, -232 ]
        size: [ 980, 980 ]
        stroke: { color: "#C9A86A12", width: 1 }
      - id: ld.ring.outer
        type: ellipse
        position: [ 552, 170 ]
        size: [ 176, 176 ]
        stroke: { color: "#C9A86A66", width: 1.5 }
      - id: ld.ring.inner
        type: ellipse
        position: [ 561, 179 ]
        size: [ 158, 158 ]
        stroke: { color: "#E7D7A880", width: 1, style: dot }
      - id: ld.arc
        type: path
        position: [ 552, 170 ]
        size: [ 176, 176 ]
        viewBox: [ 176, 176 ]
        path: "M88 0 A88 88 0 1 1 36.3 159.2"
        stroke: { color: $color.gold-bright, width: 2.5, cap: round }
      - id: ld.tick.top
        type: ellipse
        position: [ 637, 167 ]
        size: [ 6, 6 ]
        fill: $color.gold-bright
      - id: ld.tick.right
        type: ellipse
        position: [ 725, 255 ]
        size: [ 6, 6 ]
        fill: $color.gold-bright
      - id: ld.tick.bottom
        type: ellipse
        position: [ 637, 343 ]
        size: [ 6, 6 ]
        fill: $color.gold-bright
      - id: ld.tick.left
        type: ellipse
        position: [ 549, 255 ]
        size: [ 6, 6 ]
        fill: $color.gold-bright
      - id: ld.logo
        type: rect
        position: [ 578, 198 ]
        size: [ 124, 124 ]
        fill: { type: image, src: assets/logo.png, fit: contain }
      - id: ld.title
        type: text
        position: [ 0, 392 ]
        size: [ 1280, 40 ]
        align: [ center, middle ]
        fontFamily: Onest
        fontSize: 30
        fontWeight: 500
        letterSpacing: 4
        color: $color.text
        content: ORION
      - id: ld.role
        type: text
        position: [ 0, 434 ]
        size: [ 1280, 20 ]
        align: [ center, middle ]
        fontFamily: Onest
        fontSize: 14
        color: $color.ink
        content: Локальная рабочая среда
      - id: ld.steps
        type: frame
        position: [ 0, 506 ]
        size: [ 1280, hug ]
        layout: { type: flex, justifyContent: center, alignItems: center, gap: 36 }
        children:
          - id: ld.step.1
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, alignItems: center, gap: 8 }
            children:
              - id: ld.step.1.icon
                type: svg
                size: [ 12, 12 ]
                icon: fas:check
                fill: $color.gold
              - id: ld.step.1.label
                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 13
                color: "#9A927E"
                content: Подготовка
          - id: ld.step.2
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, alignItems: center, gap: 8 }
            children:
              - id: ld.step.2.icon
                type: svg
                size: [ 12, 12 ]
                icon: fas:check
                fill: $color.gold
              - id: ld.step.2.label
                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 13
                color: "#9A927E"
                content: База данных
          - id: ld.step.3
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, alignItems: center, gap: 8 }
            children:
              - id: ld.step.3.dot
                type: ellipse
                size: [ 8, 8 ]
                fill: $color.gold
              - id: ld.step.3.label
                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 13
                fontWeight: 500
                color: $color.gold-bright
                content: Структура данных
          - id: ld.step.4
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, alignItems: center, gap: 8 }
            children:
              - id: ld.step.4.dot
                type: ellipse
                size: [ 8, 8 ]
                stroke: { color: "#4A463C", width: 1 }
              - id: ld.step.4.label
                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 13
                color: $color.muted
                content: Сервер
          - id: ld.step.5
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, alignItems: center, gap: 8 }
            children:
              - id: ld.step.5.dot
                type: ellipse
                size: [ 8, 8 ]
                stroke: { color: "#4A463C", width: 1 }
              - id: ld.step.5.label
                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 13
                color: $color.muted
                content: Открытие
      - id: ld.hint
        type: text
        position: [ 0, 558 ]
        size: [ 1280, 20 ]
        align: [ center, middle ]
        fontFamily: Onest
        fontSize: 14
        color: $color.ink
        content: Первый запуск после обновления может занять больше времени
      - id: ld.track
        type: rect
        position: [ 500, 646 ]
        size: [ 280, 2 ]
        cornerRadius: 1
        fill: "#FFFFFF14"
      - id: ld.track.fill
        type: rect
        position: [ 500, 646 ]
        size: [ 154, 2 ]
        cornerRadius: 1
        fill: $color.gold
      - id: ld.elapsed
        type: text
        position: [ 0, 664 ]
        size: [ 1280, 16 ]
        align: [ center, middle ]
        fontFamily: IBM Plex Mono
        fontSize: 12
        color: $color.muted
        content: "00:12"
      - id: ld.version
        type: text
        position: [ 40, 756 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        color: "#55524A"
        content: ORION 0.2.1

  # ----------------------------------------------------- 2. Первый запуск
  - id: screen.premiere
    type: frame
    position: [ 1480, 160 ]
    size: [ 1280, 800 ]
    fill: $color.canvas
    layout: { type: free, overflow: hidden }
    children:
      - id: pr.glow
        type: ellipse
        position: [ 390, 50 ]
        size: [ 500, 500 ]
        fill:
          type: radialGradient
          stops:
            - [ 0, "#C9A86A33" ]
            - [ 1, "#C9A86A00" ]
      - id: pr.orbit.a
        type: ellipse
        position: [ 290, -50 ]
        size: [ 700, 700 ]
        stroke: { color: "#C9A86A1F", width: 1 }
      - id: pr.orbit.b
        type: ellipse
        position: [ 150, -190 ]
        size: [ 980, 980 ]
        stroke: { color: "#C9A86A12", width: 1 }
      - id: pr.pill
        type: frame
        position: [ 0, 132 ]
        size: [ 1280, hug ]
        layout: { type: flex, justifyContent: center }
        children:
          - id: pr.pill.box
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, padding: [ 6, 14 ] }
            cornerRadius: 999
            stroke: { color: "#C9A86A66", width: 1 }
            children:
              - id: pr.pill.label
                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 12
                letterSpacing: 1
                color: $color.gold
                content: Обновление 0.2.1
      - id: pr.ring.outer
        type: ellipse
        position: [ 552, 212 ]
        size: [ 176, 176 ]
        stroke: { color: "#C9A86A66", width: 1.5 }
      - id: pr.ring.inner
        type: ellipse
        position: [ 561, 221 ]
        size: [ 158, 158 ]
        stroke: { color: "#E7D7A880", width: 1, style: dot }
      - id: pr.arc
        type: path
        position: [ 552, 212 ]
        size: [ 176, 176 ]
        viewBox: [ 176, 176 ]
        path: "M88 0 A88 88 0 0 1 164.2 44"
        stroke: { color: $color.gold-bright, width: 2.5, cap: round }
      - id: pr.tick.top
        type: ellipse
        position: [ 637, 209 ]
        size: [ 6, 6 ]
        fill: $color.gold-bright
      - id: pr.tick.right
        type: ellipse
        position: [ 725, 297 ]
        size: [ 6, 6 ]
        fill: $color.gold-bright
      - id: pr.tick.bottom
        type: ellipse
        position: [ 637, 385 ]
        size: [ 6, 6 ]
        fill: $color.gold-bright
      - id: pr.tick.left
        type: ellipse
        position: [ 549, 297 ]
        size: [ 6, 6 ]
        fill: $color.gold-bright
      - id: pr.logo
        type: rect
        position: [ 578, 240 ]
        size: [ 124, 124 ]
        fill: { type: image, src: assets/logo.png, fit: contain }
      - id: pr.title
        type: text
        position: [ 0, 434 ]
        size: [ 1280, 40 ]
        align: [ center, middle ]
        fontFamily: Onest
        fontSize: 30
        fontWeight: 500
        letterSpacing: 4
        color: $color.text
        content: ORION
      - id: pr.role
        type: text
        position: [ 0, 476 ]
        size: [ 1280, 20 ]
        align: [ center, middle ]
        fontFamily: Onest
        fontSize: 14
        color: $color.ink
        content: Локальная рабочая среда
      - id: pr.headline
        type: text
        position: [ 0, 516 ]
        size: [ 1280, 28 ]
        align: [ center, middle ]
        fontFamily: Onest
        fontSize: 20
        fontWeight: 500
        color: $color.text
        content: Готовим рабочую среду
      - id: pr.steps
        type: frame
        position: [ 0, 566 ]
        size: [ 1280, hug ]
        layout: { type: flex, justifyContent: center, alignItems: center, gap: 36 }
        children:
          - id: pr.step.1
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, alignItems: center, gap: 8 }
            children:
              - id: pr.step.1.dot
                type: ellipse
                size: [ 8, 8 ]
                fill: $color.gold
              - id: pr.step.1.label
                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 13
                fontWeight: 500
                color: $color.gold-bright
                content: Подготовка
          - id: pr.step.2
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, alignItems: center, gap: 8 }
            children:
              - id: pr.step.2.dot
                type: ellipse
                size: [ 8, 8 ]
                stroke: { color: "#4A463C", width: 1 }
              - id: pr.step.2.label
                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 13
                color: $color.muted
                content: База данных
          - id: pr.step.3
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, alignItems: center, gap: 8 }
            children:
              - id: pr.step.3.dot
                type: ellipse
                size: [ 8, 8 ]
                stroke: { color: "#4A463C", width: 1 }
              - id: pr.step.3.label
                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 13
                color: $color.muted
                content: Структура данных
          - id: pr.step.4
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, alignItems: center, gap: 8 }
            children:
              - id: pr.step.4.dot
                type: ellipse
                size: [ 8, 8 ]
                stroke: { color: "#4A463C", width: 1 }
              - id: pr.step.4.label
                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 13
                color: $color.muted
                content: Сервер
          - id: pr.step.5
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, alignItems: center, gap: 8 }
            children:
              - id: pr.step.5.dot
                type: ellipse
                size: [ 8, 8 ]
                stroke: { color: "#4A463C", width: 1 }
              - id: pr.step.5.label
                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 13
                color: $color.muted
                content: Открытие
      - id: pr.hint
        type: text
        position: [ 0, 618 ]
        size: [ 1280, 20 ]
        align: [ center, middle ]
        fontFamily: Onest
        fontSize: 14
        color: $color.ink
        content: Запускаем локальные службы на этом компьютере
      - id: pr.track
        type: rect
        position: [ 500, 658 ]
        size: [ 280, 2 ]
        cornerRadius: 1
        fill: "#FFFFFF14"
      - id: pr.track.fill
        type: rect
        position: [ 500, 658 ]
        size: [ 22, 2 ]
        cornerRadius: 1
        fill: $color.gold
      - id: pr.skip
        type: text
        position: [ 0, 706 ]
        size: [ 1280, 20 ]
        align: [ center, middle ]
        fontFamily: Onest
        fontSize: 13
        color: $color.ink
        content: Пропустить
      - id: pr.version
        type: text
        position: [ 40, 756 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        color: "#55524A"
        content: ORION 0.2.1

  # ---------------------------------------------------------- 3. Ошибка
  - id: screen.error
    type: frame
    position: [ 80, 1120 ]
    size: [ 1280, 800 ]
    fill: $color.canvas
    layout: { type: free, overflow: hidden }
    children:
      - id: er.glow
        type: ellipse
        position: [ 390, 0 ]
        size: [ 500, 500 ]
        fill:
          type: radialGradient
          stops:
            - [ 0, "#C9756A22" ]
            - [ 1, "#C9756A00" ]
      - id: er.ring.outer
        type: ellipse
        position: [ 552, 158 ]
        size: [ 176, 176 ]
        stroke: { color: "#C9756A66", width: 1.5 }
      - id: er.ring.inner
        type: ellipse
        position: [ 561, 167 ]
        size: [ 158, 158 ]
        stroke: { color: "#EFB3A866", width: 1, style: dot }
      - id: er.tick.top
        type: ellipse
        position: [ 637, 155 ]
        size: [ 6, 6 ]
        fill: "#C9756A"
      - id: er.tick.right
        type: ellipse
        position: [ 725, 243 ]
        size: [ 6, 6 ]
        fill: "#C9756A"
      - id: er.tick.bottom
        type: ellipse
        position: [ 637, 331 ]
        size: [ 6, 6 ]
        fill: "#C9756A"
      - id: er.tick.left
        type: ellipse
        position: [ 549, 243 ]
        size: [ 6, 6 ]
        fill: "#C9756A"
      - id: er.logo
        type: rect
        position: [ 578, 186 ]
        size: [ 124, 124 ]
        opacity: 0.85
        fill: { type: image, src: assets/logo.png, fit: contain }
      - id: er.title
        type: text
        position: [ 0, 380 ]
        size: [ 1280, 40 ]
        align: [ center, middle ]
        fontFamily: Onest
        fontSize: 30
        fontWeight: 500
        letterSpacing: 4
        color: $color.text
        content: ORION
      - id: er.role
        type: text
        position: [ 0, 422 ]
        size: [ 1280, 20 ]
        align: [ center, middle ]
        fontFamily: Onest
        fontSize: 14
        color: $color.ink
        content: Локальная рабочая среда
      - id: er.headline
        type: text
        position: [ 0, 466 ]
        size: [ 1280, 28 ]
        align: [ center, middle ]
        fontFamily: Onest
        fontSize: 20
        fontWeight: 500
        color: $color.text
        content: Не удалось запустить ORION
      - id: er.card
        type: frame
        position: [ 400, 514 ]
        size: [ 480, hug ]
        layout: { type: flex, direction: column, gap: 10, padding: [ 16, 18 ] }
        fill: $color.card
        stroke: { color: $color.danger-deep, width: 1 }
        cornerRadius: 12
        children:
          - id: er.card.message
            type: text
            size: [ fill, hug ]
            fontFamily: Onest
            fontSize: 13
            lineHeight: 20
            color: $color.danger
            content: Локальный launcher завершился (код 1); дочерние процессы остановлены.
          - id: er.card.log
            type: text
            size: [ fill, hug ]
            fontFamily: IBM Plex Mono
            fontSize: 11
            lineHeight: 17
            color: $color.muted
            content: 'Журнал: C:\Users\admin\AppData\Roaming\orion\logs\startup.log'
      - id: er.actions
        type: frame
        position: [ 0, 666 ]
        size: [ 1280, hug ]
        layout: { type: flex, justifyContent: center, gap: 12 }
        children:
          - id: er.retry
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, padding: [ 12, 22 ] }
            fill: $color.gold
            cornerRadius: 8
            children:
              - id: er.retry.label
                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 14
                fontWeight: 500
                color: "#16171A"
                content: Проверить ещё раз
          - id: er.logs
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, padding: [ 12, 22 ] }
            cornerRadius: 8
            stroke: { color: "#4A463C", width: 1 }
            children:
              - id: er.logs.label
                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 14
                color: $color.ink
                content: Открыть журнал
      - id: er.version
        type: text
        position: [ 40, 756 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        color: "#55524A"
        content: ORION 0.2.1

  # ----------------------------------------------------- 4. Минимальный
  - id: screen.minimal
    type: frame
    position: [ 1480, 1120 ]
    size: [ 1280, 800 ]
    fill: $color.canvas
    layout: { type: free, overflow: hidden }
    children:
      - id: mn.glow
        type: ellipse
        position: [ 440, 108 ]
        size: [ 400, 400 ]
        fill:
          type: radialGradient
          stops:
            - [ 0, "#C9A86A1F" ]
            - [ 1, "#C9A86A00" ]
      - id: mn.ring
        type: ellipse
        position: [ 584, 208 ]
        size: [ 112, 112 ]
        stroke: { color: "#C9A86A55", width: 1.25 }
      - id: mn.logo
        type: rect
        position: [ 596, 220 ]
        size: [ 88, 88 ]
        fill: { type: image, src: assets/logo.png, fit: contain }
      - id: mn.title
        type: text
        position: [ 0, 352 ]
        size: [ 1280, 32 ]
        align: [ center, middle ]
        fontFamily: Onest
        fontSize: 22
        fontWeight: 500
        letterSpacing: 3
        color: $color.text
        content: ORION
      - id: mn.status
        type: frame
        position: [ 0, 404 ]
        size: [ 1280, hug ]
        layout: { type: flex, justifyContent: center, alignItems: center, gap: 8 }
        children:
          - id: mn.status.dot
            type: ellipse
            size: [ 7, 7 ]
            fill: $color.gold
          - id: mn.status.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            color: $color.ink
            content: Подключаем базу данных
      - id: mn.track
        type: rect
        position: [ 0, 798 ]
        size: [ 1280, 2 ]
        fill: "#FFFFFF10"
      - id: mn.track.fill
        type: rect
        position: [ 0, 798 ]
        size: [ 512, 2 ]
        fill: $color.gold
      - id: mn.version
        type: text
        position: [ 40, 756 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        color: "#55524A"
        content: ORION 0.2.1
