name: Концепт «Одиссея»

children:
  - id: note.od.phase
    type: text
    position: [ 80, 60 ]
    size: [ hug, hug ]
    fontSize: 34
    fontWeight: 600
    color: "#000000"
    content: Загрузка — 3 фазы

  - id: note.od.ready
    type: text
    position: [ 1480, 60 ]
    size: [ hug, hug ]
    fontSize: 34
    fontWeight: 600
    color: "#000000"
    content: На орбите

  - id: note.od.error
    type: text
    position: [ 2880, 60 ]
    size: [ hug, hug ]
    fontSize: 34
    fontWeight: 600
    color: "#000000"
    content: Сбой системы

  - id: note.od.compact
    type: text
    position: [ 4280, 60 ]
    size: [ hug, hug ]
    fontSize: 34
    fontWeight: 600
    color: "#000000"
    content: Сжатый вариант

  # ============================================================ 1. ЗАГРУЗКА
  - id: screen.odyssey
    type: frame
    position: [ 80, 120 ]
    size: [ 1280, 800 ]
    fill: $color.canvas
    layout: { type: free, overflow: hidden }
    children:
      # ---------------- сцена
      - id: od.sky
        type: frame
        position: [ 0, 0 ]
        size: [ 760, 800 ]
        layout: { type: free, overflow: hidden }
        children:
          - id: od.haze
            type: ellipse
            position: [ 160, 120 ]
            size: [ 440, 440 ]
            fill:
              type: radialGradient
              stops:
                - [ 0, "#C9A86A17" ]
                - [ 1, "#C9A86A00" ]
          # звёзды
          - id: od.s01
            type: ellipse
            position: [ 86, 118 ]
            size: [ 3, 3 ]
            fill: "#D8C9A64D"
          - id: od.s02
            type: ellipse
            position: [ 152, 66 ]
            size: [ 2, 2 ]
            fill: "#FFFFFF59"
          - id: od.s03
            type: ellipse
            position: [ 242, 152 ]
            size: [ 4, 4 ]
            fill: "#D8C9A68C"
          - id: od.s04
            type: ellipse
            position: [ 312, 82 ]
            size: [ 2, 2 ]
            fill: "#FFFFFF40"
          - id: od.s05
            type: ellipse
            position: [ 394, 128 ]
            size: [ 3, 3 ]
            fill: "#FFFFFF59"
          - id: od.s06
            type: ellipse
            position: [ 478, 68 ]
            size: [ 2, 2 ]
            fill: "#D8C9A64D"
          - id: od.s07
            type: ellipse
            position: [ 560, 146 ]
            size: [ 3, 3 ]
            fill: "#FFFFFF52"
          - id: od.s08
            type: ellipse
            position: [ 648, 88 ]
            size: [ 2, 2 ]
            fill: "#FFFFFF38"
          - id: od.s09
            type: ellipse
            position: [ 704, 198 ]
            size: [ 3, 3 ]
            fill: "#D8C9A659"
          - id: od.s10
            type: ellipse
            position: [ 62, 262 ]
            size: [ 2, 2 ]
            fill: "#FFFFFF45"
          - id: od.s11
            type: ellipse
            position: [ 132, 342 ]
            size: [ 3, 3 ]
            fill: "#FFFFFF52"
          - id: od.s12
            type: ellipse
            position: [ 228, 268 ]
            size: [ 2, 2 ]
            fill: "#D8C9A640"
          - id: od.s13
            type: ellipse
            position: [ 302, 372 ]
            size: [ 2, 2 ]
            fill: "#FFFFFF4D"
          - id: od.s14
            type: ellipse
            position: [ 420, 232 ]
            size: [ 3, 3 ]
            fill: "#D8C9A659"
          - id: od.s15
            type: ellipse
            position: [ 522, 252 ]
            size: [ 2, 2 ]
            fill: "#FFFFFF45"
          - id: od.s16
            type: ellipse
            position: [ 636, 328 ]
            size: [ 3, 3 ]
            fill: "#FFFFFF4D"
          - id: od.s17
            type: ellipse
            position: [ 704, 442 ]
            size: [ 2, 2 ]
            fill: "#D8C9A64D"
          - id: od.s18
            type: ellipse
            position: [ 94, 512 ]
            size: [ 3, 3 ]
            fill: "#FFFFFF59"
          - id: od.s19
            type: ellipse
            position: [ 182, 448 ]
            size: [ 2, 2 ]
            fill: "#D8C9A638"
          - id: od.s20
            type: ellipse
            position: [ 268, 592 ]
            size: [ 3, 3 ]
            fill: "#FFFFFF4D"
          - id: od.s21
            type: ellipse
            position: [ 356, 522 ]
            size: [ 2, 2 ]
            fill: "#FFFFFF40"
          - id: od.s22
            type: ellipse
            position: [ 486, 562 ]
            size: [ 3, 3 ]
            fill: "#D8C9A652"
          - id: od.s23
            type: ellipse
            position: [ 588, 486 ]
            size: [ 2, 2 ]
            fill: "#FFFFFF45"
          - id: od.s24
            type: ellipse
            position: [ 668, 588 ]
            size: [ 3, 3 ]
            fill: "#FFFFFF52"
          - id: od.s25
            type: ellipse
            position: [ 122, 662 ]
            size: [ 2, 2 ]
            fill: "#D8C9A64D"
          - id: od.s26
            type: ellipse
            position: [ 332, 682 ]
            size: [ 2, 2 ]
            fill: "#FFFFFF40"
          - id: od.s27
            type: ellipse
            position: [ 468, 702 ]
            size: [ 3, 3 ]
            fill: "#D8C9A645"
          - id: od.s28
            type: ellipse
            position: [ 604, 662 ]
            size: [ 2, 2 ]
            fill: "#FFFFFF4D"
          - id: od.s29
            type: ellipse
            position: [ 704, 722 ]
            size: [ 2, 2 ]
            fill: "#FFFFFF38"
          # орбита и эклиптика
          - id: od.orbit
            type: ellipse
            position: [ 230, 250 ]
            size: [ 300, 300 ]
            stroke: { color: "#C9A86A29", width: 1, style: custom, dash: [ 3, 7 ] }
          - id: od.orbit.arc
            type: path
            position: [ 230, 250 ]
            size: [ 300, 300 ]
            viewBox: [ 300, 300 ]
            path: "M150 0 A150 150 0 0 1 300 150"
            stroke: { color: "#C9A86A66", width: 1.5, cap: round }
          - id: od.trail
            type: path
            position: [ 100, 120 ]
            size: [ 360, 280 ]
            viewBox: [ 360, 280 ]
            path: "M10 270 Q 180 200 330 30"
            stroke: { color: "#E7D7A8B3", width: 2, cap: round }
          - id: od.probe.glow
            type: ellipse
            position: [ 410, 140 ]
            size: [ 60, 60 ]
            fill:
              type: radialGradient
              stops:
                - [ 0, "#E7D7A899" ]
                - [ 1, "#E7D7A800" ]
          - id: od.probe
            type: ellipse
            position: [ 434, 164 ]
            size: [ 12, 12 ]
            fill: "#FFF4D4"
          - id: od.probe.core
            type: ellipse
            position: [ 438, 168 ]
            size: [ 4, 4 ]
            fill: "#FFFFFF"
          - id: od.plane.glow
            type: ellipse
            position: [ 140, 230 ]
            size: [ 340, 340 ]
            fill:
              type: radialGradient
              stops:
                - [ 0, "#C9A86A1A" ]
                - [ 1, "#C9A86A00" ]
          - id: od.belt.1
            type: ellipse
            position: [ 356, 366 ]
            size: [ 9, 9 ]
            fill: "#C9A86A"
          - id: od.belt.2
            type: ellipse
            position: [ 374, 384 ]
            size: [ 10, 10 ]
            fill: "#D8BE85"
          - id: od.belt.3
            type: ellipse
            position: [ 394, 400 ]
            size: [ 9, 9 ]
            fill: "#C9A86A"
          - id: od.ecliptic
            type: line
            position: [ 30, 560 ]
            size: [ 700, 0 ]
            stroke: { color: "#E7D7A81F", width: 1, style: custom, dash: [ 2, 6 ] }
          - id: od.ecliptic.label
            type: text
            position: [ 600, 570 ]
            size: [ hug, hug ]
            fontFamily: IBM Plex Mono
            fontSize: 10
            letterSpacing: 3
            color: "#6E6A60"
            content: ЭКЛИПТИКА
          # навигационные шкалы слева
          - id: od.nav.az
            type: text
            position: [ 40, 60 ]
            size: [ hug, hug ]
            fontFamily: IBM Plex Mono
            fontSize: 11
            letterSpacing: 2
            color: $color.ink
            content: АЗ 047.2°
          - id: od.nav.ra
            type: text
            position: [ 40, 86 ]
            size: [ hug, hug ]
            fontFamily: IBM Plex Mono
            fontSize: 11
            letterSpacing: 2
            color: "#6E6A60"
            content: RA 05h 35m
          - id: od.nav.dec
            type: text
            position: [ 40, 112 ]
            size: [ hug, hug ]
            fontFamily: IBM Plex Mono
            fontSize: 11
            letterSpacing: 2
            color: "#6E6A60"
            content: DEC −05° 23′
      # ---------------- консоль
      - id: od.divider
        type: rect
        position: [ 760, 40 ]
        size: [ 1, 720 ]
        fill: "#FFFFFF14"
      - id: od.tag
        type: text
        position: [ 820, 60 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        letterSpacing: 3
        color: $color.gold
        content: ПОСЛЕДОВАТЕЛЬНОСТЬ ЗАПУСКА
      - id: od.title
        type: text
        position: [ 820, 92 ]
        size: [ hug, hug ]
        fontFamily: Onest
        fontSize: 44
        fontWeight: 500
        letterSpacing: 5
        color: $color.text
        content: ORION
      - id: od.role
        type: text
        position: [ 820, 152 ]
        size: [ hug, hug ]
        fontFamily: Onest
        fontSize: 13
        color: $color.ink
        content: Навигация по личным и семейным делам
      # фазы
      - id: od.phase.1
        type: frame
        position: [ 820, 212 ]
        size: [ hug, hug ]
        layout: { type: flex, alignItems: center, gap: 12 }
        children:
          - id: od.phase.1.icon
            type: svg
            size: [ 13, 13 ]
            icon: fas:check
            fill: $color.gold
          - id: od.phase.1.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            color: "#9A927E"
            content: Ядро оболочки
      - id: od.phase.2
        type: frame
        position: [ 820, 250 ]
        size: [ hug, hug ]
        layout: { type: flex, alignItems: center, gap: 12 }
        children:
          - id: od.phase.2.icon
            type: svg
            size: [ 13, 13 ]
            icon: fas:check
            fill: $color.gold
          - id: od.phase.2.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            color: "#9A927E"
            content: Хранилище данных
      - id: od.phase.3
        type: frame
        position: [ 820, 288 ]
        size: [ hug, hug ]
        layout: { type: flex, alignItems: center, gap: 12 }
        children:
          - id: od.phase.3.dot
            type: ellipse
            size: [ 9, 9 ]
            fill: $color.gold
          - id: od.phase.3.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            fontWeight: 500
            color: $color.gold-bright
            content: Карты и индексы
      - id: od.phase.4
        type: frame
        position: [ 820, 326 ]
        size: [ hug, hug ]
        layout: { type: flex, alignItems: center, gap: 12 }
        children:
          - id: od.phase.4.dot
            type: ellipse
            size: [ 9, 9 ]
            stroke: { color: "#4A463C", width: 1 }
          - id: od.phase.4.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            color: $color.muted
            content: Службы приложения
      - id: od.phase.5
        type: frame
        position: [ 820, 364 ]
        size: [ hug, hug ]
        layout: { type: flex, alignItems: center, gap: 12 }
        children:
          - id: od.phase.5.dot
            type: ellipse
            size: [ 9, 9 ]
            stroke: { color: "#4A463C", width: 1 }
          - id: od.phase.5.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            color: $color.muted
            content: Выход на орбиту
      # стек проверок
      - id: od.stack
        type: frame
        position: [ 820, 440 ]
        size: [ 380, hug ]
        layout: { type: flex, direction: column, gap: 14 }
        children:
          - id: od.check.1
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, justifyContent: spaceBetween }
            children:
              - id: od.check.1.label
                type: text
                size: [ hug, hug ]
                fontFamily: IBM Plex Mono
                fontSize: 12
                color: "#9A927E"
                content: Оболочка Tauri
              - id: od.check.1.value
                type: text
                size: [ hug, hug ]
                fontFamily: IBM Plex Mono
                fontSize: 12
                color: $color.muted
                content: ок · 0.4 с
          - id: od.check.2
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, justifyContent: spaceBetween }
            children:
              - id: od.check.2.label
                type: text
                size: [ hug, hug ]
                fontFamily: IBM Plex Mono
                fontSize: 12
                color: "#9A927E"
                content: PostgreSQL 16
              - id: od.check.2.value
                type: text
                size: [ hug, hug ]
                fontFamily: IBM Plex Mono
                fontSize: 12
                color: $color.muted
                content: ок · 1.2 с
          - id: od.check.3
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, justifyContent: spaceBetween }
            children:
              - id: od.check.3.label
                type: text
                size: [ hug, hug ]
                fontFamily: IBM Plex Mono
                fontSize: 12
                color: $color.gold-bright
                content: Миграции
              - id: od.check.3.value
                type: text
                size: [ hug, hug ]
                fontFamily: IBM Plex Mono
                fontSize: 12
                color: $color.gold
                content: 14 / 21
      - id: od.track
        type: rect
        position: [ 820, 646 ]
        size: [ 380, 2 ]
        cornerRadius: 1
        fill: "#FFFFFF14"
      - id: od.track.fill
        type: rect
        position: [ 820, 646 ]
        size: [ 241, 2 ]
        cornerRadius: 1
        fill: $color.gold
      - id: od.percent
        type: text
        position: [ 820, 664 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        letterSpacing: 2
        color: $color.ink
        content: 63%
      - id: od.coords
        type: text
        position: [ 820, 740 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        letterSpacing: 2
        color: "#55524A"
        content: СЕАНС 014  ·  КАНАЛ БЕТА  ·  0.2.1

  # ============================================================ 2. НА ОРБИТЕ
  - id: screen.od.ready
    type: frame
    position: [ 1480, 120 ]
    size: [ 1280, 800 ]
    fill: $color.canvas
