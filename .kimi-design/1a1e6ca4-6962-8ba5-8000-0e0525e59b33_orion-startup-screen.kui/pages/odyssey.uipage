            fontFamily: IBM Plex Mono
            fontSize: 11
            letterSpacing: 2
            color: $color.danger
            content: СИГНАЛ ПОТЕРЯН
          - id: ode.nav.ra
            type: text
            position: [ 40, 86 ]
            size: [ hug, hug ]
            fontFamily: IBM Plex Mono
            fontSize: 11
            letterSpacing: 2
            color: "#6E6A60"
            content: RA 05h 35m
          - id: ode.nav.dec
            type: text
            position: [ 40, 112 ]
            size: [ hug, hug ]
            fontFamily: IBM Plex Mono
            fontSize: 11
            letterSpacing: 2
            color: "#6E6A60"
            content: DEC −05° 23′
      - id: ode.divider
        type: rect
