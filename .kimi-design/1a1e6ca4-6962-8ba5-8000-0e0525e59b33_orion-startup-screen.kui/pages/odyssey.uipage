        size: [ 1, 720 ]
        fill: "#FFFFFF14"
      - id: ode.tag
        type: text
        position: [ 820, 60 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        letterSpacing: 3
        color: $color.danger
        content: СБОЙ ПОСЛЕДОВАТЕЛЬНОСТИ
      - id: ode.title
        type: text
        position: [ 820, 92 ]
        size: [ hug, hug ]
        fontFamily: Onest
        fontSize: 44
        fontWeight: 500
        letterSpacing: 5
        color: $color.text
        content: ORION
      - id: ode.role
        type: text
        position: [ 820, 152 ]
        size: [ hug, hug ]
        fontFamily: Onest
        fontSize: 13
        color: $color.ink
        content: Запуск остановлен на второй фазе
      - id: ode.phase.1
        type: frame
        position: [ 820, 212 ]
        size: [ hug, hug ]
