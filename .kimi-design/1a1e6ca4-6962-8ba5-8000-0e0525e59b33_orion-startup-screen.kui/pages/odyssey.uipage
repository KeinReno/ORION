            fontSize: 14
            color: "#9A927E"
            content: Ядро оболочки
      - id: ode.phase.2
        type: frame
        position: [ 820, 250 ]
        size: [ hug, hug ]
        layout: { type: flex, alignItems: center, gap: 12 }
        children:
          - id: ode.phase.2.icon
            type: svg
            size: [ 13, 13 ]
            icon: fas:xmark
            fill: $color.danger
          - id: ode.phase.2.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            fontWeight: 500
            color: $color.danger
            content: Хранилище данных
      - id: ode.phase.3
        type: frame
        position: [ 820, 288 ]
        size: [ hug, hug ]
        layout: { type: flex, alignItems: center, gap: 12 }
        children:
          - id: ode.phase.3.dot
            type: ellipse
            size: [ 9, 9 ]
            stroke: { color: "#4A463C", width: 1 }
          - id: ode.phase.3.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            color: $color.muted
            content: Карты и индексы
      - id: ode.phase.4
        type: frame
        position: [ 820, 326 ]
        size: [ hug, hug ]
        layout: { type: flex, alignItems: center, gap: 12 }
        children:
          - id: ode.phase.4.dot
            type: ellipse
            size: [ 9, 9 ]
            stroke: { color: "#4A463C", width: 1 }
          - id: ode.phase.4.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            color: $color.muted
            content: Службы приложения
      - id: ode.phase.5
        type: frame
        position: [ 820, 364 ]
        size: [ hug, hug ]
        layout: { type: flex, alignItems: center, gap: 12 }
        children:
          - id: ode.phase.5.dot
            type: ellipse
            size: [ 9, 9 ]
            stroke: { color: "#4A463C", width: 1 }
          - id: ode.phase.5.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            color: $color.muted
            content: Выход на орбиту
      # карточка ошибки
      - id: ode.card
        type: frame
        position: [ 820, 430 ]
        size: [ 380, hug ]
        layout: { type: flex, direction: column, gap: 10, padding: [ 16, 18 ] }
        fill: $color.card
        stroke: { color: $color.danger-deep, width: 1 }
        cornerRadius: 12
        children:
          - id: ode.card.message
            type: text
            size: [ fill, hug ]
            fontFamily: Onest
            fontSize: 13
            lineHeight: 20
            color: $color.danger
            content: Хранилище данных не отвечает. Проверьте, что PostgreSQL запущен и порт
              5432 свободен.
          - id: ode.card.log
            type: text
            size: [ fill, hug ]
            fontFamily: IBM Plex Mono
            fontSize: 11
            lineHeight: 17
            color: $color.muted
            content: 'Журнал: C:\Users\admin\AppData\Roaming\orion\logs\startup.log'
      - id: ode.actions
        type: frame
        position: [ 820, 596 ]
        size: [ hug, hug ]
        layout: { type: flex, gap: 12 }
        children:
          - id: ode.retry
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, padding: [ 12, 22 ] }
            fill: $color.gold
            cornerRadius: 8
            children:
