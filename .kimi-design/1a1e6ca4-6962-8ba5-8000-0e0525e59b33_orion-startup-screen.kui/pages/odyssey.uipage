        position: [ 0, 0 ]
        size: [ 760, 800 ]
        layout: { type: free, overflow: hidden }
        children:
          - id: ode.haze
            type: ellipse
            position: [ 160, 120 ]
            size: [ 440, 440 ]
            fill:
              type: radialGradient
