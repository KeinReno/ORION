      - id: oda.logo
        type: rect
        position: [ 296, 266 ]
        size: [ 168, 168 ]
        opacity: 0.25
        fill: { type: image, src: assets/logo.png, fit: contain }
      - id: oda.ecliptic
        type: line
        position: [ 30, 560 ]
        size: [ 700, 0 ]
        stroke: { color: "#E7D7A81F", width: 1, style: custom, dash: [ 2, 6 ] }
      - id: oda.ecliptic.label
        type: text
        position: [ 600, 570 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 10
        letterSpacing: 3
        color: "#6E6A60"
        content: ЭКЛИПТИКА
      - id: oda.nav.az
        type: text
        position: [ 40, 60 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        letterSpacing: 2
        color: "#BEB9AF"
        content: АЗ 047.2°
      - id: oda.nav.ra
        type: text
        position: [ 40, 86 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        letterSpacing: 2
        color: "#6E6A60"
        content: RA 05h 35m
      - id: oda.nav.dec
        type: text
        position: [ 40, 112 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        letterSpacing: 2
        color: "#6E6A60"
        content: DEC −05° 23′
      - id: oda.divider
        type: rect
        position: [ 760, 40 ]
        size: [ 1, 720 ]
        fill: "#FFFFFF14"
      - id: oda.tag
        type: text
        position: [ 820, 60 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        letterSpacing: 3
        color: $color.gold
        content: ПОСЛЕДОВАТЕЛЬНОСТЬ ЗАПУСКА
      - id: oda.title
        type: text
        position: [ 820, 92 ]
        size: [ hug, hug ]
        fontFamily: Onest
        fontSize: 44
        fontWeight: 500
        letterSpacing: 5
        color: $color.text
        content: ORION
      - id: oda.role
        type: text
        position: [ 820, 152 ]
        size: [ hug, hug ]
        fontFamily: Onest
        fontSize: 13
        color: $color.ink
        content: Навигация по личным и семейным делам
      - id: oda.phase.0
        type: frame
        position: [ 820, 212 ]
        size: [ hug, hug ]
        layout: { type: flex, alignItems: center, gap: 12 }
        children:
          - id: oda.phase.0.icon
            type: svg
            size: [ 13, 13 ]
            icon: fas:check
            fill: $color.gold
          - id: oda.phase.0.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            color: "#9A927E"
            content: Ядро оболочки
      - id: oda.phase.1
        type: frame
        position: [ 820, 250 ]
        size: [ hug, hug ]
        layout: { type: flex, alignItems: center, gap: 12 }
        children:
          - id: oda.phase.1.icon
            type: svg
            size: [ 13, 13 ]
            icon: fas:check
            fill: $color.gold
          - id: oda.phase.1.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            color: "#9A927E"
            content: Хранилище данных
      - id: oda.phase.2
        type: frame
        position: [ 820, 288 ]
        size: [ hug, hug ]
        layout: { type: flex, alignItems: center, gap: 12 }
        children:
          - id: oda.phase.2.dot
            type: ellipse
            size: [ 9, 9 ]
            fill: $color.gold
          - id: oda.phase.2.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            fontWeight: 500
            color: $color.gold-bright
            content: Карты и индексы
      - id: oda.phase.3
        type: frame
        position: [ 820, 326 ]
        size: [ hug, hug ]
        layout: { type: flex, alignItems: center, gap: 12 }
        children:
          - id: oda.phase.3.dot
            type: ellipse
            size: [ 9, 9 ]
            stroke: { color: "#4A463C", width: 1 }
          - id: oda.phase.3.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            color: $color.muted
            content: Службы приложения
      - id: oda.phase.4
        type: frame
        position: [ 820, 364 ]
        size: [ hug, hug ]
        layout: { type: flex, alignItems: center, gap: 12 }
        children:
          - id: oda.phase.4.dot
            type: ellipse
            size: [ 9, 9 ]
            stroke: { color: "#4A463C", width: 1 }
          - id: oda.phase.4.label
            type: text
            size: [ hug, hug ]
            fontFamily: Onest
            fontSize: 14
            color: $color.muted
            content: Выход на орбиту
      - id: oda.track
        type: rect
        position: [ 820, 646 ]
        size: [ 380, 2 ]
        cornerRadius: 1
        fill: "#FFFFFF14"
      - id: oda.track.fill
        type: rect
        position: [ 820, 646 ]
        size: [ 198, 2 ]
        cornerRadius: 1
        fill: $color.gold
      - id: oda.percent
        type: text
        position: [ 820, 664 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        letterSpacing: 2
        color: $color.ink
        content: 52%
      - id: oda.coords
        type: text
        position: [ 820, 740 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        letterSpacing: 2
        color: "#55524A"
        content: СЕАНС 014  ·  КАНАЛ БЕТА  ·  0.2.1
