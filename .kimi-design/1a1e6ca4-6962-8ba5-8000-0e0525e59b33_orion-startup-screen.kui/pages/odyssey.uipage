              - id: odr.check.1.value
                type: text
                size: [ hug, hug ]
                fontFamily: IBM Plex Mono
                fontSize: 12
                color: $color.muted
                content: ок · 0.4 с
          - id: odr.check.2
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, justifyContent: spaceBetween }
            children:
              - id: odr.check.2.label
                type: text
                size: [ hug, hug ]
