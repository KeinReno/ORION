                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 14
                fontWeight: 500
                color: "#16171A"
                content: Проверить ещё раз
          - id: ode.logs
            type: frame
            size: [ hug, hug ]
            layout: { type: flex, padding: [ 12, 22 ] }
            cornerRadius: 8
            stroke: { color: "#4A463C", width: 1 }
            children:
              - id: ode.logs.label
                type: text
                size: [ hug, hug ]
                fontFamily: Onest
                fontSize: 14
                color: $color.ink
                content: Открыть журнал
      - id: ode.coords
        type: text
        position: [ 820, 740 ]
        size: [ hug, hug ]
        fontFamily: IBM Plex Mono
        fontSize: 11
        letterSpacing: 2
        color: "#55524A"
        content: СЕАНС 014  ·  КАНАЛ БЕТА  ·  0.2.1

