            size: [ 3, 3 ]
            fill: "#D8C9A659"
          - id: ode.s11
            type: ellipse
            position: [ 132, 342 ]
            size: [ 3, 3 ]
            fill: "#FFFFFF52"
          - id: ode.s14
            type: ellipse
            position: [ 420, 232 ]
            size: [ 3, 3 ]
            fill: "#D8C9A659"
          - id: ode.s16
            type: ellipse
            position: [ 636, 328 ]
            size: [ 3, 3 ]
            fill: "#FFFFFF4D"
          - id: ode.s18
            type: ellipse
            position: [ 94, 512 ]
            size: [ 3, 3 ]
            fill: "#FFFFFF59"
          - id: ode.s20
            type: ellipse
            position: [ 268, 592 ]
            size: [ 3, 3 ]
            fill: "#FFFFFF4D"
          - id: ode.s22
            type: ellipse
            position: [ 486, 562 ]
            size: [ 3, 3 ]
            fill: "#D8C9A652"
          - id: ode.s24
            type: ellipse
            position: [ 668, 588 ]
            size: [ 3, 3 ]
            fill: "#FFFFFF52"
          - id: ode.s26
            type: ellipse
            position: [ 332, 682 ]
            size: [ 2, 2 ]
            fill: "#FFFFFF40"
          - id: ode.s28
            type: ellipse
            position: [ 604, 662 ]
            size: [ 2, 2 ]
            fill: "#FFFFFF4D"
          - id: ode.orbit
            type: ellipse
            position: [ 230, 250 ]
            size: [ 300, 300 ]
            stroke: { color: "#C9756A29", width: 1, style: custom, dash: [ 3, 7 ] }
          # прерванный след
          - id: ode.trail
            type: path
            position: [ 100, 120 ]
            size: [ 360, 280 ]
            viewBox: [ 360, 280 ]
            path: "M10 270 Q 150 214 250 140"
            stroke: { color: "#C9756A99", width: 2, cap: round }
          - id: ode.probe.glow
            type: ellipse
            position: [ 320, 230 ]
            size: [ 60, 60 ]
            fill:
              type: radialGradient
              stops:
                - [ 0, "#EFB3A880" ]
                - [ 1, "#EFB3A800" ]
          - id: ode.probe
            type: ellipse
            position: [ 344, 254 ]
            size: [ 12, 12 ]
            fill: "#EFB3A8"
          - id: ode.plane.glow
            type: ellipse
            position: [ 140, 230 ]
            size: [ 340, 340 ]
            fill:
              type: radialGradient
              stops:
                - [ 0, "#C9A86A0F" ]
                - [ 1, "#C9A86A00" ]
          - id: ode.belt.1
            type: ellipse
            position: [ 356, 366 ]
            size: [ 9, 9 ]
            fill: "#6E5F46"
          - id: ode.belt.2
            type: ellipse
            position: [ 374, 384 ]
            size: [ 10, 10 ]
            fill: "#6E5F46"
          - id: ode.belt.3
            type: ellipse
            position: [ 394, 400 ]
            size: [ 9, 9 ]
            fill: "#6E5F46"
          - id: ode.ecliptic
            type: line
            position: [ 30, 560 ]
            size: [ 700, 0 ]
            stroke: { color: "#E7D7A81F", width: 1, style: custom, dash: [ 2, 6 ] }
          - id: ode.nav.az
            type: text
            position: [ 40, 60 ]
