            type: ellipse
            position: [ 486, 562 ]
            size: [ 3, 3 ]
            fill: "#D8C9A652"
          - id: odr.s23
            type: ellipse
            position: [ 588, 486 ]
            size: [ 2, 2 ]
            fill: "#FFFFFF45"
          - id: odr.s24
            type: ellipse
            position: [ 668, 588 ]
            size: [ 3, 3 ]
            fill: "#FFFFFF52"
          - id: odr.s25
            type: ellipse
            position: [ 122, 662 ]
            size: [ 2, 2 ]
            fill: "#D8C9A64D"
          - id: odr.s26
