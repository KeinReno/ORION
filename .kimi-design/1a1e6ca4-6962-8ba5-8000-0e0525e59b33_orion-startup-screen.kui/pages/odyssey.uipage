      - id: odr.stack
        type: frame
        position: [ 820, 440 ]
        size: [ 380, hug ]
        layout: { type: flex, direction: column, gap: 14 }
        children:
          - id: odr.check.1
            type: frame
            size: [ fill, hug ]
            layout: { type: flex, justifyContent: spaceBetween }
            children:
              - id: odr.check.1.label
                type: text
